BASE_URL=https://developer-qa.ineight.com

# Local mobile emulation for Cucumber runs (any Playwright device name, e.g. "Pixel 7", "iPhone 14")
# DEVICE=Pixel 7

# BrowserStack
# BROWSERSTACK=true
# BROWSERSTACK_USERNAME=
# BROWSERSTACK_ACCESS_KEY=
# BROWSERSTACK_BUILD_NAME=
# Real Android device (Cucumber only). Leave unset to use a BrowserStack desktop browser.
# BS_DEVICE=Samsung Galaxy S23
# BS_OS_VERSION=13.0
# Desktop browser settings when BS_DEVICE is unset
# BS_BROWSER=chrome
# BS_OS=Windows
